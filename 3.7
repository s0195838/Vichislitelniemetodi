import math
import re
import time


class SteffensenSolver:
    """
    Интерактивный решатель уравнений.
    Метод Стеффенсена = МПИ + λ²-процесс Эйткена.
    """
    
    def __init__(self):
        self.safe_dict = {
            'sin': math.sin, 'cos': math.cos, 'tan': math.tan,
            'asin': math.asin, 'acos': math.acos, 'atan': math.atan,
            'sinh': math.sinh, 'cosh': math.cosh, 'tanh': math.tanh,
            'exp': math.exp, 'log': math.log, 'log10': math.log10,
            'log2': math.log2, 'sqrt': math.sqrt, 'abs': abs,
            'pi': math.pi, 'e': math.e, 'ceil': math.ceil, 'floor': math.floor
        }
    
    def create_g(self, equation_str):
        """Парсит строку и создаёт функцию g(x) для МПИ x = g(x)."""
        equation_str = equation_str.strip()
        
        if '=' in equation_str:
            parts = equation_str.split('=') #проверяет, есть ли в строке знак =. Если да, разбивает строку на части.(!)
            
            if len(parts) == 2:
                left = parts[0].strip()
                right = parts[1].strip()#если частей ровно две (слева и справа от =), убираем пробелы с каждой.
                
                
                if left == 'x':
                    expr = right
                elif right == 'x': #Определяет, где располагается 'x'
                    expr = left
                else:
                    print("[ВНИМАНИЕ] Уравнение не в форме 'x = g(x)'. Использую правую часть как g(x).")
                    expr = right
                    
                    
            else:
                expr = parts[-1].strip()#если знаков = больше одного (например, "x = y = z"), берём последнюю часть.
        else:
            expr = equation_str#если знака = нет (пользователь ввёл просто "cos(x)"), используем всю строку как выражение.
        
        expr = expr.replace('^', '**')
        
        code = compile(expr, '<input>', 'eval')# превращает строку в готовый к выполнению байт-код.
        
        
        safe_dict = self.safe_dict #сохраняем ссылку на словарь с функциями, чтобы она была доступна внутри g(x).
        
        def g(x):
            try:
                safe_dict['x'] = x# кладём текущее значение x в словарь
                result = eval(code, {"__builtins__": {}}, safe_dict)
                
                if not isinstance(result, (int, float)):#Проверка на то, что result это число 
                    raise ValueError(f"Функция вернула не число, а {type(result)}")
                    
                if math.isnan(result) or math.isinf(result):#проверяет, не является ли результат NaN (Not a Number) или бесконечностью.
                    raise ValueError(f"Функция вернула {result}")
                return result
            except Exception as e:
                raise ValueError(f"Ошибка при вычислении g({x:.6f}): {e}")
                
        
        #Пробует вызвать g(x) на 4 разных точках.
        #Если хотя бы одна точка сработала — всё хорошо.
        test_points = [0.0, 0.5, 1.0, -0.5]
        test_ok = False
        last_error = None
        
        for tp in test_points:
            try:
                val = g(tp)
                test_ok = True
            except Exception as e:
                last_error = e
        
        if not test_ok:
            raise ValueError(f"Функция не работает ни на одном тестовом значении. Пример ошибки: {last_error}")
        
        #возвращает кортеж из двух элементов:
        #g — готовая к использованию функция.
        #expr — строка выражения (для вывода на экран).
        
        return g, expr
    
    
    
    
    #g — функция правой части x = g(x)
    #x0 — начальное приближение
    #eps — требуемая точность (по умолчанию 0.0000000001)
    #max_iter — максимальное число итераций (защита от бесконечного цикла)
    #verbose — печатать ли подробную информацию (True) или работать молча (False)
    def solve_steffensen(self, g, x0, eps=1e-10, max_iter=100, verbose=True):
        """
        Метод Стеффенсена (МПИ + дельта^2-процесс Эйткена).
        
        Возвращает:
            (корень, история_итераций) или (None, история) если не сошлось
        """
        history = [(0, x0, None, None, None, x0)]
        
        if verbose:
            print(f"\n  Старт из x0 = {x0:.10f}")
        
        #цикл от 1 до max_iter включительно. i — номер текущей итерации.
        for i in range(1, max_iter + 1):
            try:
                #мы смотрим, как ведёт себя функция в окрестности x0
                x1 = g(x0)
                x2 = g(x1)
                # чтобы оценить коэффициент затухания λ нужно три точки(x0,x1,x2)
            except ValueError as e:
                if verbose:
                    print(f"    ❌ Ошибка: {e}")
                return None, history
            
            denominator = x2 - 2.0 * x1 + x0#В тетради: вторая конечная разность Δ²x₀
            
            #Проверка на если знаменатель почти ноль
            if abs(denominator) < 1e-15:
                x_new = x2
                lambda_est = None
                
            #Вычисление λ и прыжок Эйткена
            else:
                #Оценка λ (коэффициента затухания)
                lambda_est = (x2 - x1) / (x1 - x0) if abs(x1 - x0) > 1e-15 else None
                #Мы предполагаем, что ошибка убывает как геометрическая прогрессия со знаменателем λ.
                #По трём точкам находим λ.
                #Вычисляем предел этой прогрессии (корень) — и прыгаем прямо туда.
                x_new = x0 - ((x1 - x0) ** 2) / denominator
            
            
            #Вычисление невязки и запись в историю
            error = abs(x_new - x0)
            history.append((i, x0, x1, x2, lambda_est, x_new))
            
            #Проверка сходимости
            #если невязка меньше требуемой точности, возвращаем корень.
            if error < eps:
                if verbose:
                    print(f"    ✅ сошёлся за {i} итераций → x = {x_new:.12f}")
                return x_new, history
            
            x0 = x_new
        
        #Если цикл закончился, а точность не достигнута, возвращаем последнее приближение
        if verbose:
            print(f"    ⚠️  достигнут лимит итераций")
        return x0, history
    
    
    #обычный метод простых итераций
    def solve_mpi(self, g, x0, eps=1e-10, max_iter=100, verbose=True):
        """Обычный МПИ x_{n+1} = g(x_n)."""
        history = [(0, x0, abs(x0 - x0))]
        
        if verbose:
            print(f"\n  Старт из x0 = {x0:.10f}")
        
        x_prev = x0
        for i in range(1, max_iter + 1):
            try:
                x_new = g(x_prev)
            except ValueError as e:
                if verbose:
                    print(f"    ❌ Ошибка: {e}")
                return None, history
            
            err = abs(x_new - x_prev)
            history.append((i, x_new, err))
            
            
            #проверка сходимости, обновление точки.
            if err < eps:
                if verbose:
                    print(f"    ✅ сошёлся за {i} итераций → x = {x_new:.12f}")
                return x_new, history
            
            x_prev = x_new
            
        #Обработка случая, когда метод не сошёлся за отведённое число итераций.
        if verbose:
            print(f"    ⚠️  достигнут лимит итераций")
        return x_prev, history
    
    
    # ============================================================
    # НОВЫЙ МЕТОД: поиск всех корней на отрезке [a, b]
    # ============================================================
    def find_all_roots(self, g, a, b, method='steffensen', eps=1e-10, max_iter=100, num_initial=50):
        """
        Поиск всех корней уравнения x = g(x) на отрезке [a, b].

        Идея:
          - Разбиваем отрезок [a, b] на num_initial равных частей.
          - Из каждой точки разбиения запускаем выбранный метод.
          - Собираем все найденные корни.
          - Убираем дубликаты (корни, отличающиеся менее чем на погрешность).

        Параметры:
          g            : функция правой части x = g(x)
          a, b         : границы отрезка
          method       : 'steffensen' или 'mpi'
          eps          : точность для метода
          max_iter     : максимальное число итераций
          num_initial  : на сколько частей разбить отрезок для сканирования

        Возвращает:
          список уникальных корней (отсортированный)
        """
        method_name = "Стеффенсена" if method == 'steffensen' else "МПИ"
        
        print("\n" + "="*70)
        print(f"  ПОИСК ВСЕХ КОРНЕЙ НА ОТРЕЗКЕ [{a}, {b}]")
        print(f"  Метод: {method_name}")
        print("="*70)
        print(f"  Отрезок:          [{a}, {b}]")
        print(f"  Точек разбиения:  {num_initial}")
        print(f"  Точность (eps):   {eps}")
        print()

        # Генерируем точки разбиения (включая концы отрезка)
        h = (b - a) / num_initial
        start_points = [a + i * h for i in range(num_initial + 1)]

        raw_roots = []   # сюда будем складывать все найденные корни
        failed = 0       # счётчик неудачных запусков

        # Выбираем функцию-решатель
        if method == 'steffensen':
            solver_func = self.solve_steffensen
        else:
            solver_func = self.solve_mpi

        print("Сканирование отрезка...")
        print(f"{'Старт x0':<16} {'Результат':<18} {'Статус'}")
        print("-" * 50)

        for x0 in start_points:
            try:
                root, _ = solver_func(g, x0, eps=eps, max_iter=max_iter, verbose=False)
            except Exception:
                # если совсем не получилось (например, выход за область определения)
                root = None

            if root is None:
                failed += 1
                print(f"{x0:<16.10f} {'---':<18} ❌ не сошлось")
                continue

            # Проверяем, что корень лежит в пределах отрезка (с небольшим запасом)
            margin = (b - a) * 0.1  # 10% от длины отрезка
            if root < a - margin or root > b + margin:
                print(f"{x0:<16.10f} {root:<18.10f} ⚠️  выход за отрезок, отброшен")
                continue

            raw_roots.append(root)
            print(f"{x0:<16.10f} {root:<18.10f} ✅")

        if not raw_roots:
            print(f"\n❌ Не найдено ни одного корня (неудачных запусков: {failed}).")
            print("   Попробуйте увеличить num_initial или изменить отрезок.")
            return []

        # Убираем дубликаты: группируем близкие корни
        unique_roots = self._filter_unique(raw_roots, eps=eps)

        print(f"\n{'='*70}")
        print(f"  РЕЗУЛЬТАТЫ ПОИСКА")
        print(f"{'='*70}")
        print(f"  Всего сырых корней:     {len(raw_roots)}")
        print(f"  Уникальных корней:      {len(unique_roots)}")
        print(f"  Неудачных запусков:     {failed}")

        if unique_roots:
            print(f"\n  📌 НАЙДЕННЫЕ КОРНИ:")
            for idx, r in enumerate(unique_roots, 1):
                print(f"     {idx}. x = {r:.14f}")

        print(f"{'='*70}")
        return unique_roots

    def _filter_unique(self, roots, eps=1e-10):
        """
        Группирует близкие корни (расстояние < tol) и возвращает
        по одному представителю от каждой группы (среднее арифметическое).
        """
        if not roots:
            return []

        # Сортируем корни по возрастанию
        sorted_roots = sorted(roots)

        # Порог "одинаковости": можно настроить
        tol = max(eps, 1e-8)  # не меньше 1e-8

        groups = []
        current_group = [sorted_roots[0]]

        for r in sorted_roots[1:]:
            if abs(r - current_group[-1]) < tol:
                # Этот корень принадлежит текущей группе
                current_group.append(r)
            else:
                # Начинаем новую группу
                groups.append(current_group)
                current_group = [r]

        groups.append(current_group)  # не забываем последнюю группу

        # От каждой группы берём среднее арифметическое
        unique = []
        for grp in groups:
            avg = sum(grp) / len(grp)
            unique.append(avg)

        return unique


def menu():
    """Главное меню программы."""
    solver = SteffensenSolver()
    
    print("\n" + "="*70)
    print("   МПИ + λ²-ПРОЦЕСС ЭЙТКЕНА (МЕТОД СТЕФФЕНСЕНА)")
    print("="*70)
    print("Решает уравнения вида x = g(x)")
    print()
    print("Встроенные функции: sin, cos, tan, asin, acos, atan,")
    print("  sinh, cosh, tanh, exp, log, sqrt, abs, pi, e")
    print()
    print("Примеры ввода:")
    print("  cos(x)        — корень x = cos(x)")
    print("  exp(-x)       — корень x = exp(-x)")
    print("  1 + sin(x)/2  — корень x = 1 + sin(x)/2")
    print("="*70)
    
    while True:
        print("\n" + "-"*70)
        print("МЕНЮ:")
        print("  1 — Найти все корни методом Стеффенсена (МПИ + λ²-Эйткен)")
        print("  2 — Найти все корни обычным МПИ")
        print("  3 — Сравнить оба метода (поиск всех корней)")
        print("  4 — Запустить демо-примеры")
        print("  0 — Выход")
        print("-"*70)
        
        choice = input("Выбор [0-4]: ").strip()
        
        if choice == '0':
            print("\nДо свидания!")
            break
        
        elif choice in ('1', '2', '3'):
            # Ввод функции
            print("\nВведите функцию g(x) для уравнения x = g(x):")
            print("  (можно ввести 'cos(x)' или 'x = cos(x)' — оба варианта работают)")
            eq_str = input("g(x) = ").strip()
            
            if not eq_str:
                print("❌ Функция не может быть пустой.")
                continue
            
            try:
                g, parsed = solver.create_g(eq_str)
            except Exception as e:
                print(f"❌ {e}")
                continue
            
            # Ввод отрезка
            print("\nВведите отрезок для поиска корней:")
            a_str = input("Левая граница a [0]: ").strip()
            try:
                a = float(a_str) if a_str else 0.0
            except ValueError:
                print("❌ Некорректное число.")
                continue

            b_str = input("Правая граница b [10]: ").strip()
            try:
                b = float(b_str) if b_str else 10.0
            except ValueError:
                print("❌ Некорректное число.")
                continue

            if a >= b:
                print("❌ Левая граница должна быть меньше правой.")
                continue
            
            # Точность
            eps_str = input("Точность [1e-10]: ").strip()
            try:
                eps = float(eps_str) if eps_str else 1e-10
            except ValueError:
                print("❌ Некорректная точность.")
                continue
            
            # Итерации
            maxit_str = input("Максимум итераций [100]: ").strip()
            try:
                max_iter = int(maxit_str) if maxit_str else 100
            except ValueError:
                print("❌ Некорректное число итераций.")
                continue
            
            # Число точек разбиения
            num_str = input("Число точек разбиения отрезка [50]: ").strip()
            try:
                num_initial = int(num_str) if num_str else 50
            except ValueError:
                print("❌ Некорректное число.")
                continue
            
            print(f"\n📝 ПАРАМЕТРЫ:")
            print(f"  g(x) = {parsed}")
            print(f"  Отрезок: [{a}, {b}]")
            print(f"  Точность: {eps},  max_iter: {max_iter}")
            print(f"  Точек разбиения: {num_initial}")
            
            if choice == '1':
                # Только метод Стеффенсена
                solver.find_all_roots(g, a, b, method='steffensen', eps=eps, max_iter=max_iter, num_initial=num_initial)
            
            elif choice == '2':
                # Только обычный МПИ
                solver.find_all_roots(g, a, b, method='mpi', eps=eps, max_iter=max_iter, num_initial=num_initial)
            
            elif choice == '3':
                # Сравнение: оба метода ищут все корни
                print("\n" + "="*70)
                print("  СРАВНЕНИЕ МЕТОДОВ (ПОИСК ВСЕХ КОРНЕЙ)")
                print("="*70)
                
                print("\n🔵 МЕТОД СТЕФФЕНСЕНА:")
                start = time.time()
                roots_steff = solver.find_all_roots(g, a, b, method='steffensen', eps=eps, max_iter=max_iter, num_initial=num_initial)
                time_steff = time.time() - start
                
                print("\n🔵 ОБЫЧНЫЙ МПИ:")
                start = time.time()
                roots_mpi = solver.find_all_roots(g, a, b, method='mpi', eps=eps, max_iter=max_iter, num_initial=num_initial)
                time_mpi = time.time() - start
                
                # Итоговая таблица сравнения
                print("\n" + "="*70)
                print("  ИТОГОВОЕ СРАВНЕНИЕ")
                print("="*70)
                print(f"  Корней найдено (Стеффенсен):  {len(roots_steff)}")
                print(f"  Корней найдено (МПИ):         {len(roots_mpi)}")
                print(f"  Время Стеффенсена:            {time_steff:.4f} сек")
                print(f"  Время МПИ:                    {time_mpi:.4f} сек")
                
                if time_steff > 0 and time_mpi > 0:
                    if time_mpi > time_steff:
                        print(f"  🚀 Стеффенсен быстрее в {time_mpi/time_steff:.1f} раз(а)")
                    else:
                        print(f"  МПИ быстрее в {time_steff/time_mpi:.1f} раз(а)")
                
                # Сравнение корней
                if roots_steff and roots_mpi:
                    matched = 0
                    for rs in roots_steff:
                        for rm in roots_mpi:
                            if abs(rs - rm) < 1e-8:
                                matched += 1
                                break
                    print(f"  Совпадающих корней:           {matched}")
                
                print(f"{'='*70}")
                
                print(f"\n💡 ПОЯСНЕНИЕ:")
                print(f"  МПИ сходится линейно:")
                print(f"    |x_(n+1) - x*| ≈ λ · |x_n - x*|")
                print(f"  Процесс Эйткена оценивает λ по трём точкам и исключает её,")
                print(f"  превращая линейную сходимость в квадратичную.")
                print()
        
        elif choice == '4':
            run_demos(solver)
        else:
            print("Неверный ввод, попробуйте снова.")


def run_demos(solver):
    """Готовые демо-примеры."""
    demos = [
        ("x = cos(x) на [0, 10]", "cos(x)", 0, 10, 1e-10, 30),
        ("x = exp(-x) на [0, 5]", "exp(-x)", 0, 5, 1e-10, 30),
        ("x = 1 + sin(x)/2 на [0, 5]", "1 + sin(x)/2", 0, 5, 1e-10, 30),
        ("x = sqrt(x+1) на [0, 5]", "sqrt(x+1)", 0, 5, 1e-10, 30),
    ]
    
    for idx, (name, expr, a, b, eps, num) in enumerate(demos):
        print("\n" + "="*70)
        print(f"  ДЕМО: {name}")
        print("="*70)
        try:
            g, parsed = solver.create_g(expr)
            print(f"  g(x) = {parsed}")
            print(f"  Отрезок: [{a}, {b}]")
            
            print("\n🔵 Метод Стеффенсена:")
            start = time.time()
            roots_steff = solver.find_all_roots(g, a, b, method='steffensen', eps=eps, max_iter=100, num_initial=num)
            time_steff = time.time() - start
            
            print("\n🔵 Обычный МПИ:")
            start = time.time()
            roots_mpi = solver.find_all_roots(g, a, b, method='mpi', eps=eps, max_iter=100, num_initial=num)
            time_mpi = time.time() - start
            
            print(f"\n📊 СРАВНЕНИЕ:")
            print(f"  Корней (Стеффенсен): {len(roots_steff)} за {time_steff:.4f} сек")
            print(f"  Корней (МПИ):        {len(roots_mpi)} за {time_mpi:.4f} сек")
            
        except Exception as e:
            print(f"❌ Ошибка в демо: {e}")
        
        if idx < len(demos) - 1:
            input("\nНажмите Enter для следующего примера...")


if __name__ == "__main__":
    menu()
