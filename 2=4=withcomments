"""
Интерполяционная схема Эйткена
С поддержкой ручного ввода данных пользователем
"""

def aitken(x_nodes, y_nodes, x):
    """
    Интерполяция по схеме Эйткена.
    
    Параметры:
        x_nodes : list[float] - узлы интерполяции
        y_nodes : list[float] - значения функции в узлах
        x : float - точка, в которой нужно найти значение
    
    Возвращает:
        float - интерполированное значение y(x)
    """
    n = len(x_nodes) #Определяет количество узлов интерполяции.
    col = list(y_nodes) #Создаёт копию списка значений Y. 
    #Это будет нулевой столбец таблицы Эйткена (интерполяция степени 0 — просто значения в узлах).
    
    for k in range(1, n):
        #Внешний цикл — проходит по столбцам таблицы Эйткена.
        #k=1 → линейная интерполяция (степень 1)
        #k=2 → квадратичная интерполяция (степень 2)
        #k=n-1 → интерполяция степени n-1 (финальный результат)
        new_col = [] # пустой список для столбцов
        for i in range(n - k):
            #Внутренний цикл — вычисляет элементы текущего столбца.(Количество элементов в столбце k равно n - k)
            numerator = (x_nodes[i] - x) * col[i+1] - (x_nodes[i+k] - x) * col[i]
            denominator = x_nodes[i] - x_nodes[i+k]
            new_col.append(numerator / denominator) # Выполняет деление числителя на знаменатель
                                                    #Добавляет результат в новый столбец
        col = new_col
    
    return col[0]


def aitken_with_sorting(x_nodes, y_nodes, x):
    """Схема Эйткена с сортировкой узлов по близости к x."""
    #zip(x_nodes, y_nodes) — объединяет списки X и Y в список пар (кортежей): [(x0,y0), (x1,y1), ...]
    #sorted(..., key=...) сортирует эти пары
    #lambda p: abs(p[0] - x) — ключ сортировки:
    #p — это кортеж (x_i, y_i)
    #p[0] — это x_i
    #abs(p[0] - x) — расстояние от узла до точки x
    points = sorted(zip(x_nodes, y_nodes), key=lambda p: abs(p[0] - x))
    x_sorted, y_sorted = zip(*points)
    #*points — распаковывает список пар в отдельные аргументы
    #zip(...) — транспонирует: из списка пар делает две последовательности
    #x_sorted, y_sorted — присваивает эти последовательности переменным
    return aitken(list(x_sorted), list(y_sorted), x)


def print_table(x_nodes, y_nodes, title="Исходные данные"):
    """Вывод таблицы в красивом формате."""
    print(f"\n{title}")
    print("─" * 50)
    print(f"{'№':^4} {'x':^12} {'y':^12}")
    print("─" * 50)
    for i, (x, y) in enumerate(zip(x_nodes, y_nodes)):
        #:^4 - центрирование в поле шириной 4 или 12
        # x:^12.6f — X с 6 знаками после запятой, ширина 12
        print(f"{i:^4} {x:^12.6f} {y:^12.6f}")
    print("─" * 50)


def interactive_input():
    """
    Интерактивный ввод данных пользователем.
    """
    print("\n" + "="*60)
    print(" РЕЖИМ РУЧНОГО ВВОДА ДАННЫХ")
    print("="*60)
    
    # Ввод количества узлов
    while True:
        try:
            n = int(input("\nВведите количество узлов интерполяции: "))
            if n >= 2:
                break
            print("Ошибка: нужно хотя бы 2 узла. Повторите ввод.")
        except ValueError:
            print("Ошибка: введите целое число.")
    
    x_nodes = []
    y_nodes = []
    
    print("\nВведите узлы (x, y):")
    print("Формат: x y (через пробел)")
    print("-" * 40)
    
    for i in range(n):
        while True:
            try:
                text = input(f"Узел {i+1}: ").strip().split()
                if len(text) != 2:
                    print("Ошибка: нужно ввести два числа (x и y).")
                    continue
                
                x = float(text[0])
                y = float(text[1])
                
                # Проверка на дублирование x
                if x in x_nodes:
                    print(f"Предупреждение: узел x={x} уже существует.")
                    overwrite = input("Заменить? (y/n): ").lower()
                    if overwrite == 'y':
                        idx = x_nodes.index(x)
                        x_nodes[idx] = x
                        y_nodes[idx] = y
                        print(f"Узел {i+1} обновлён: ({x}, {y})")
                    else:
                        continue
                else:
                    x_nodes.append(x)
                    y_nodes.append(y)
                break
            except ValueError:
                print("Ошибка: введите числа в формате: x y")
    
    return x_nodes, y_nodes


def interactive_interpolation():
    """
    Основная интерактивная функция.
    """
    print("\n" + "█"*60)
    print("█" + " " * 58 + "█")
    print("█     ИНТЕРПОЛЯЦИОННАЯ СХЕМА ЭЙТКЕНА     █")
    print("█" + " " * 58 + "█")
    print("█"*60)
    
    # Ввод данных
    x_nodes, y_nodes = interactive_input()
    
    if not x_nodes:
        print("Ошибка: данные не загружены")
        return
    
    # Вывод таблицы
    print_table(x_nodes, y_nodes, "Введённые данные")
    
    # Ввод точки интерполяции
    while True:
        try:
            x_target = float(input("\nВведите точку x для интерполяции: "))
            break
        except ValueError:
            print("Ошибка: введите число")
    
    # Вычисление
    result_regular = aitken(x_nodes, y_nodes, x_target)
    result_sorted = aitken_with_sorting(x_nodes, y_nodes, x_target)
    
    # Вывод результатов
    print("\n" + "="*60)
    print(" РЕЗУЛЬТАТЫ")
    print("="*60)
    print(f"\nИнтерполяция в точке x = {x_target}")
    print(f"  Без сортировки: y = {result_regular:.8f}")
    print(f"  С сортировкой:   y = {result_sorted:.8f}")
    
    # Проверка в узлах (демонстрация точности)
    print("\nПроверка в узлах интерполяции:")
    for xi, yi in zip(x_nodes, y_nodes):
        val = aitken(x_nodes, y_nodes, xi)
        status = "✓" if abs(val - yi) < 1e-10 else "✗"
        print(f"  x = {xi:.6f}: вычислено {val:.8f} (должно {yi:.8f}) {status}")
    
    # Дополнительные опции
    print("\n" + "-"*40)
    more = input("Показать пошаговую таблицу Эйткена? (y/n): ").lower()
    if more == 'y':
        show_aitken_table(x_nodes, y_nodes, x_target)
    
    # Интерполяция в нескольких точках
    more = input("\nИнтерполировать в нескольких точках? (y/n): ").lower()
    if more == 'y':
        try:
            points = input("Введите x через пробел: ").split()
            x_points = [float(p) for p in points]
            print("\nРезультаты:")
            print("─" * 50)
            print(f"{'x':^12} {'y(x)':^16}")
            print("─" * 50)
            for xp in x_points:
                yp = aitken_with_sorting(x_nodes, y_nodes, xp)
                print(f"{xp:^12.6f} {yp:^16.8f}")
            print("─" * 50)
        except ValueError:
            print("Ошибка: некорректный ввод")


def show_aitken_table(x_nodes, y_nodes, x):
    """Показать заполнение таблицы Эйткена."""
    n = len(x_nodes)
    # Сортируем узлы по близости
    points = sorted(zip(x_nodes, y_nodes), key=lambda p: abs(p[0] - x))
    x_sorted, y_sorted = zip(*points)
    x_sorted = list(x_sorted)
    y_sorted = list(y_sorted)
    
    # Создаём таблицу
    table = [[None] * n for _ in range(n)]
    for i in range(n):
        table[i][0] = y_sorted[i]
    
    print(f"\nТаблица Эйткена для x = {x}")
    print("="*70)
    
    # Заголовок
    header = f"{'i':^4} {'x_i':^8} {'y_i':^8}"
    for k in range(1, min(n, 7)):
        if k == 1:
            header += f" {'P_{i,i+1}':^12}"
        elif k == 2:
            header += f" {'P_{i,i+2}':^12}"
        else:
            header += f" {'P_{i,i+' + str(k) + '}':^12}"
    print(header)
    print("-"*70)
    
    # Заполняем и выводим
    for k in range(1, n):
        for i in range(n - k):
            num = (x_sorted[i] - x) * table[i+1][k-1] - (x_sorted[i+k] - x) * table[i][k-1]
            den = x_sorted[i] - x_sorted[i+k]
            table[i][k] = num / den
    
    # Вывод строк
    for i in range(n):
        row = f"{i:^4} {x_sorted[i]:^8.4f} {table[i][0]:^8.4f}"
        for k in range(1, n - i):
            row += f" {table[i][k]:^12.6f}"
        print(row)
    
    print("="*70)
    print(f"Результат: y({x}) = {table[0][n-1]:.8f}")


def batch_interpolation():
    """
    Пакетная интерполяция для множества точек.
    """
    print("\n" + "="*60)
    print(" ПАКЕТНАЯ ИНТЕРПОЛЯЦИЯ")
    print("="*60)
    
    # Ввод данных
    x_nodes, y_nodes = interactive_input()
    if not x_nodes:
        return
    
    print_table(x_nodes, y_nodes, "Исходные данные")
    
    # Ввод диапазона
    print("\nВведите диапазон для интерполяции:")
    try:
        x_min = float(input("x_min: "))
        x_max = float(input("x_max: "))
        n_points = int(input("Количество точек: "))
    except ValueError:
        print("Ошибка ввода")
        return
    
    if n_points < 2:
        n_points = 10
    
    step = (x_max - x_min) / (n_points - 1)
    
    print("\n" + "="*60)
    print(" РЕЗУЛЬТАТЫ ПАКЕТНОЙ ИНТЕРПОЛЯЦИИ")
    print("="*60)
    print(f"{'x':^12} {'y(x)':^16}")
    print("-"*30)
    
    results = []
    for i in range(n_points):
        x = x_min + i * step
        y = aitken_with_sorting(x_nodes, y_nodes, x)
        results.append((x, y))
        print(f"{x:^12.6f} {y:^16.8f}")
    
    # Сохранение в файл
    save = input("\nСохранить результаты в файл? (y/n): ").lower()
    if save == 'y':
        filename = input("Имя файла: ").strip()
        try:
            with open(filename, 'w', encoding='utf-8') as f:
                f.write("# Результаты интерполяции по схеме Эйткена\n")
                f.write("# x\ty\n")
                for x, y in results:
                    f.write(f"{x}\t{y}\n")
            print(f"Результаты сохранены в {filename}")
        except Exception as e:
            print(f"Ошибка сохранения: {e}")


