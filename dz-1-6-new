"""
Обращение матрицы с помощью LU-разложения
Основано на теоретическом материале учебника:
Вержбицкий В.М. "Численные методы. Линейная алгебра и нелинейные уравнения"
(Глава 2, разделы 2.1-2.6)
"""

import numpy as np

def lu_decomposition_verzhbitsky(A):
    """
    LU-разложение по методу Дулиттла с частичным выбором главного элемента.
    
    Входные параметры:
        A - квадратная матрица размерности n x n
        
    Выходные значения:
        L - нижняя треугольная матрица с единицами на диагонали
        U - верхняя треугольная матрица
        P - матрица перестановок (P·A = L·U)
    
    Математическая основа:
        Метод Гаусса с выбором главного элемента. На каждом шаге k:
        1. Находим максимальный по модулю элемент в k-м столбце (начиная с k-й строки)
        2. Если нужно, переставляем строки для улучшения численной устойчивости
        3. Вычисляем множители для обнуления элементов под диагональю
        4. Запоминаем множители в L и обновляем U
    """
    n = A.shape[0]                    # Получаем размерность матрицы
    L = np.eye(n)                      # Инициализируем L как единичную матрицу
    U = A.copy().astype(float)         # Копируем A в U (будем преобразовывать)
    P = np.eye(n)                       # Инициализируем P как единичную матрицу
    
    # Основной цикл по столбцам (до предпоследнего, т.к. последний столбец обрабатывается автоматически)
    for k in range(n-1):
        # ===== 1. ЧАСТИЧНЫЙ ВЫБОР ГЛАВНОГО ЭЛЕМЕНТА =====
        # Ищем индекс строки с максимальным по модулю элементом в k-м столбце
        # U[k:, k] - срез от k-й строки до конца в k-м столбце
        # np.argmax находит индекс максимального элемента в этом срезе
        # Добавляем k, чтобы получить глобальный индекс в матрице
        max_idx = np.argmax(np.abs(U[k:, k])) + k
        
        # Если нашли строку с большим элементом, делаем перестановку
        if max_idx != k:
            # Меняем местами строки k и max_idx в матрице U
            # Это нужно, чтобы на диагональ поставить максимальный элемент
            U[[k, max_idx]] = U[[max_idx, k]]
            
            # Запоминаем эту перестановку в матрице P
            # P будет хранить все сделанные перестановки
            P[[k, max_idx]] = P[[max_idx, k]]
            
            # Корректируем уже вычисленные элементы L (если k > 0)
            # Меняем местами соответствующие строки в L, но только до k-го столбца
            if k > 0:
                L[[k, max_idx], :k] = L[[max_idx, k], :k]
        
        # ===== 2. ПРОВЕРКА НА ВЫРОЖДЕННОСТЬ =====
        # Если диагональный элемент практически равен нулю (даже после перестановки),
        # значит матрица вырождена и не имеет обратной
        if abs(U[k, k]) < 1e-15:
            raise ValueError("Матрица вырождена - деление на нуль")
        
        # ===== 3. ПРЯМОЙ ХОД МЕТОДА ГАУССА =====
        # Обнуляем элементы под диагональю в k-м столбце
        for i in range(k+1, n):
            # Вычисляем множитель, на который нужно умножить k-ю строку
            # чтобы вычесть её из i-й строки и обнулить U[i, k]
            factor = U[i, k] / U[k, k]
            
            # Запоминаем этот множитель в матрицу L
            # В L[i, k] будет храниться коэффициент, с которым U[k] входит в i-е уравнение
            L[i, k] = factor
            
            # Обновляем i-ю строку матрицы U:
            # Вычитаем из неё k-ю строку, умноженную на factor
            # Это обнуляет U[i, k] и изменяет остальные элементы строки
            U[i, k:] -= factor * U[k, k:]
    
    # Возвращаем результаты разложения
    return L, U, P


def forward_substitution(L, b):
    """
    Прямая подстановка для решения системы Ly = b.
    
    Входные параметры:
        L - нижняя треугольная матрица (с единицами на диагонали)
        b - вектор правой части
        
    Выходное значение:
        y - решение системы Ly = b
    
    Математическая основа:
        Для нижней треугольной матрицы решение находится последовательно
        сверху вниз. На i-м шаге известны y[0], y[1], ..., y[i-1],
        поэтому y[i] можно выразить как:
        y[i] = (b[i] - сумма(L[i,j]*y[j] для j=0..i-1)) / L[i,i]
        
        Так как на диагонали L стоят единицы, деление не меняет результат,
        но оставлено для общности.
    """
    n = L.shape[0]           # Получаем размерность системы
    y = np.zeros(n)           # Инициализируем вектор решения нулями
    
    # Проходим по строкам сверху вниз
    for i in range(n):
        # Вычисляем сумму произведений уже найденных компонент
        # L[i, :i] - первые i элементов i-й строки L
        # y[:i] - первые i элементов вектора y
        sum_ = np.dot(L[i, :i], y[:i])
        
        # Находим i-ю компоненту решения
        # b[i] - правая часть, sum_ - известная часть, L[i,i] - диагональный элемент
        y[i] = (b[i] - sum_) / L[i, i]
    
    return y


def backward_substitution(U, y):
    """
    Обратная подстановка для решения системы Ux = y.
    
    Входные параметры:
        U - верхняя треугольная матрица
        y - вектор правой части (результат прямой подстановки)
        
    Выходное значение:
        x - решение системы Ux = y
    
    Математическая основа:
        Для верхней треугольной матрицы решение находится последовательно
        снизу вверх. На i-м шаге (двигаясь от n-1 к 0) известны 
        x[i+1], x[i+2], ..., x[n-1], поэтому x[i] можно выразить как:
        x[i] = (y[i] - сумма(U[i,j]*x[j] для j=i+1..n-1)) / U[i,i]
    """
    n = U.shape[0]           # Получаем размерность системы
    x = np.zeros(n)           # Инициализируем вектор решения нулями
    
    # Проходим по строкам снизу вверх (от последней к первой)
    for i in range(n-1, -1, -1):
        # Вычисляем сумму произведений уже найденных компонент
        # U[i, i+1:] - элементы i-й строки справа от диагонали
        # x[i+1:] - уже найденные компоненты решения
        sum_ = np.dot(U[i, i+1:], x[i+1:])
        
        # Находим i-ю компоненту решения
        # y[i] - правая часть, sum_ - известная часть, U[i,i] - диагональный элемент
        x[i] = (y[i] - sum_) / U[i, i]
    
    return x


def inverse_matrix_verzhbitsky(A):
    """
    Обращение матрицы с помощью LU-разложения.
    
    Входные параметры:
        A - исходная квадратная матрица
        
    Выходное значение:
        A_inv - обратная матрица (A·A_inv ≈ I)
    
    Математическая основа:
        Обратная матрица A⁻¹ - это матрица, столбцы которой являются решениями
        систем A·xⱼ = eⱼ, где eⱼ - j-й столбец единичной матрицы.
        
        Алгоритм:
        1. Раскладываем A = P⁻¹·L·U (фактически получаем P·A = L·U)
        2. Для каждого j от 0 до n-1:
           - Применяем перестановку к j-му столбцу единичной матрицы: b = P·eⱼ
           - Решаем L·y = b (прямая подстановка)
           - Решаем U·x = y (обратная подстановка)
           - Записываем x в j-й столбец обратной матрицы
        3. Возвращаем полученную матрицу
    """
    n = A.shape[0]           # Получаем размерность матрицы
    
    # Проверяем, что матрица квадратная
    if A.shape[0] != A.shape[1]:
        raise ValueError("Матрица должна быть квадратной")
    
    # ===== 1. ПОЛУЧАЕМ LU-РАЗЛОЖЕНИЕ =====
    L, U, P = lu_decomposition_verzhbitsky(A)
    
    # ===== 2. ВЫВОДИМ РЕЗУЛЬТАТЫ РАЗЛОЖЕНИЯ =====
    print("\n" + "="*60)
    print("LU-РАЗЛОЖЕНИЕ")
    print("="*60)
    
    print("\nМатрица A (исходная):")
    print(A)
    
    print("\nМатрица L (нижняя треугольная с единицами на диагонали):")
    print(np.round(L, 8))
    
    print("\nМатрица U (верхняя треугольная):")
    print(np.round(U, 8))
    
    print("\nМатрица перестановок P:")
    print(P)
    
    # ===== 3. ПРОВЕРЯЕМ, ЧТО P·L·U = A =====
    print("\n" + "-"*40)
    print("ПРОВЕРКА: P·L·U = A")
    print("-"*40)
    PLU = P @ L @ U           # Умножаем матрицы в правильном порядке
    print("\nРезультат умножения P·L·U:")
    print(np.round(PLU, 10))
    
    # Сравниваем полученное произведение с исходной матрицей A
    # allclose проверяет поэлементное равенство с заданными допусками
    if np.allclose(PLU, A, rtol=1e-8, atol=1e-10):
        print("\n✓ P·L·U в точности равна исходной матрице A")
    else:
        print("\n⚠️ Есть небольшие расхождения (в пределах машинной точности)")
    
    # ===== 4. ВЫЧИСЛЯЕМ ОБРАТНУЮ МАТРИЦУ =====
    I = np.eye(n)             # Создаем единичную матрицу размерности n
    A_inv = np.zeros((n, n))   # Инициализируем матрицу для обратной
    
    # Решаем систему для каждого столбца единичной матрицы
    for j in range(n):
        # Берем j-й столбец единичной матрицы и применяем к нему перестановку P
        # Это соответствует правой части системы A·x = eⱼ с учетом перестановок
        b = P @ I[:, j]
        
        # Решаем L·y = b (прямая подстановка)
        y = forward_substitution(L, b)
        
        # Решаем U·x = y (обратная подстановка)
        x = backward_substitution(U, y)
        
        # Записываем полученное решение в j-й столбец обратной матрицы
        A_inv[:, j] = x
    
    return A_inv


# ================== ОСНОВНАЯ ПРОГРАММА ==================

print("="*70)
print("ОБРАЩЕНИЕ МАТРИЦЫ С ПОМОЩЬЮ LU-РАЗЛОЖЕНИЯ")
print("="*70)

# ===== ВВОД РАЗМЕРНОСТИ МАТРИЦЫ =====
while True:
    try:
        n = int(input("\nВведите размерность матрицы (n x n): "))
        if n > 0:
            break
        print("Размерность должна быть положительным числом!")
    except ValueError:
        print("Пожалуйста, введите целое число!")

# ===== ВВОД ЭЛЕМЕНТОВ МАТРИЦЫ =====
print(f"\nВведите элементы матрицы {n}x{n} (по строкам, числа через пробел):")
A = []

for i in range(n):
    while True:
        try:
            # Читаем строку ввода и разбиваем на числа
            row_str = input(f"Строка {i+1}: ").strip()
            row = list(map(float, row_str.split()))
            
            # Проверяем, что введено правильное количество чисел
            if len(row) != n:
                print(f"Ошибка! В строке должно быть {n} чисел.")
                continue
            
            # Добавляем строку в матрицу
            A.append(row)
            break
        except ValueError:
            print("Ошибка! Введите корректные числа (используйте точку для дробных).")

# Преобразуем список списков в массив numpy
A = np.array(A)

# ===== ВЫЧИСЛЕНИЕ ОБРАТНОЙ МАТРИЦЫ =====
try:
    # Вызываем функцию обращения матрицы
    # Внутри функции уже выводятся L, U, P и проверка PLU = A
    A_inv = inverse_matrix_verzhbitsky(A)
    
    # ===== ВЫВОД РЕЗУЛЬТАТОВ =====
    print("\n" + "="*60)
    print("ОБРАТНАЯ МАТРИЦА")
    print("="*60)
    
    print("\nОбратная матрица A⁻¹:")
    print(np.round(A_inv, 8))
    
    # ===== ПРОВЕРКА: A·A⁻¹ ДОЛЖНА БЫТЬ ЕДИНИЧНОЙ =====
    print("\n" + "-"*40)
    print("ПРОВЕРКА: A·A⁻¹ = I")
    print("-"*40)
    product = A @ A_inv        # Умножаем исходную матрицу на обратную
    print("\nРезультат умножения A·A⁻¹:")
    print(np.round(product, 10))
    
    # Проверяем, насколько результат близок к единичной матрице
    if np.allclose(product, np.eye(n), rtol=1e-8, atol=1e-10):
        print("\n✓ A·A⁻¹ равна единичной матрице I")
    else:
        print("\n⚠️ Есть небольшие расхождения (в пределах машинной точности)")
    
    # Вычисляем норму ошибки (меру отклонения от единичной матрицы)
    error_norm = np.linalg.norm(product - np.eye(n))
    print(f"\nНорма ошибки ||A·A⁻¹ - I||: {error_norm:.2e}")
    
except Exception as e:
    # Обрабатываем возможные ошибки (вырожденная матрица, деление на ноль и т.д.)
    print(f"\nОшибка: {e}")
    print("Матрица, вероятно, вырождена или плохо обусловлена.")
    
print("\n" + "="*70)
print("РАБОТА ПРОГРАММЫ ЗАВЕРШЕНА")
print("="*70)
