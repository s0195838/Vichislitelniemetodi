
def create_matrix(n, value=0.0):
    """Создает квадратную матрицу n x n, заполненную value"""
    return [[value for _ in range(n)] for _ in range(n)]


def identity_matrix(n):
    """Создает единичную матрицу n x n"""
    I = create_matrix(n)
    for i in range(n):
        I[i][i] = 1.0
    return I


def copy_matrix(A):
    """Создает копию матрицы"""
    return [row[:] for row in A]


def matrix_multiply(A, B):
    """Умножение матриц A и B"""
    n = len(A)
    result = create_matrix(n)

    for i in range(n):
        for j in range(n):
            s = 0.0
            for k in range(n):
                s += A[i][k] * B[k][j]
            result[i][j] = s

    return result


def swap_rows(matrix, row1, row2):
    """Меняет местами две строки в матрице"""
    matrix[row1], matrix[row2] = matrix[row2], matrix[row1]


def swap_rows_partial(matrix, row1, row2, col_limit):
    """Меняет строки местами только в первых col_limit столбцах"""
    for j in range(col_limit):
        matrix[row1][j], matrix[row2][j] = matrix[row2][j], matrix[row1][j]

    """decimals - при округлении"""
def round_matrix(matrix, decimals=8):
    """Округляет все элементы матрицы"""
    n = len(matrix)
    return [[round(matrix[i][j], decimals) for j in range(n)] for i in range(n)]

    """precision - при выводе чисел"""
def print_matrix(name, matrix, precision=8):
    """Выводит матрицу с округлением"""
    print(f"\n{name}:")
    rounded = round_matrix(matrix, precision)
    for row in rounded:
        print("  " + " ".join(f"{val:{precision +3}.{precision}f}" for val in row))


def lu_decomposition(A):
    """
    LU-разложение с выбором главного элемента.
    Возвращает L, U, P такие что P·A = L·U
    """
    n = len(A)
    L = identity_matrix(n)
    U = copy_matrix(A)
    P = identity_matrix(n)

    for k in range(n - 1):
        # Поиск главного элемента в k-м столбце
        max_idx = k
        max_val = abs(U[k][k])
        for i in range(k + 1, n):
            if abs(U[i][k]) > max_val:
                max_val = abs(U[i][k])
                max_idx = i

        # Перестановка строк при необходимости
        if max_idx != k:
            swap_rows(U, k, max_idx)
            swap_rows(P, k, max_idx)
            if k > 0:
                swap_rows_partial(L, k, max_idx, k)

        # Проверка на вырожденность
        if abs(U[k][k]) < 1e-15:
            raise ValueError("Матрица вырождена")

        # Прямой ход метода Гаусса
        for i in range(k + 1, n):
            factor = U[i][k] / U[k][k]
            L[i][k] = factor
            for j in range(k, n):
                U[i][j] -= factor * U[k][j]

    return L, U, P


def forward_substitution(L, b):
    """Решение системы L·y = b (L - нижняя треугольная)"""
    n = len(L)
    y = [0.0] * n

    for i in range(n):
        total = 0.0
        for j in range(i):
            total += L[i][j] * y[j]
        y[i] = (b[i] - total) / L[i][i]

    return y


def backward_substitution(U, y):
    """Решение системы U·x = y (U - верхняя треугольная)"""
    n = len(U)
    x = [0.0] * n

    for i in range(n - 1, -1, -1):
        total = 0.0
        for j in range(i + 1, n):
            total += U[i][j] * x[j]
        x[i] = (y[i] - total) / U[i][i]

    return x


def apply_permutation(P, v):
    """Умножение матрицы перестановок P на вектор v"""
    n = len(P)
    result = [0.0] * n

    for i in range(n):
        for j in range(n):
            result[i] += P[i][j] * v[j]

    return result


def inverse_matrix(A):
    """
    Вычисляет обратную матрицу через LU-разложение
    """
    n = len(A)

    # LU-разложение
    L, U, P = lu_decomposition(A)

    # Вывод результатов разложения
    print("\n" + "=" * 60)
    print("LU-РАЗЛОЖЕНИЕ")
    print("=" * 60)

    print_matrix("Матрица A (исходная)", A)
    print_matrix("Матрица L (нижняя треугольная)", L)
    print_matrix("Матрица U (верхняя треугольная)", U)
    print_matrix("Матрица перестановок P", P)

    # Проверка P·L·U = A
    print("\n" + "-" * 40)
    print("ПРОВЕРКА: P·L·U = A")
    print("-" * 40)

    PL = matrix_multiply(P, L)
    PLU = matrix_multiply(PL, U)
    print_matrix("Результат P·L·U", PLU, precision=10)

    # Сравнение с исходной матрицей
    is_equal = True
    for i in range(n):
        for j in range(n):
            if abs(PLU[i][j] - A[i][j]) > 1e-8:
                is_equal = False
                break

    if is_equal:
        print("\nP·L·U равна исходной матрице A")
    else:
        print("\nЕсть небольшие расхождения (в пределах машинной точности)")

    # Вычисление обратной матрицы
    I = identity_matrix(n)
    A_inv = create_matrix(n)

    for j in range(n):
        # Берем j-й столбец единичной матрицы
        e = [I[i][j] for i in range(n)]

        # Применяем перестановку
        b = apply_permutation(P, e)

        # Решаем L·y = b
        y = forward_substitution(L, b)

        # Решаем U·x = y
        x = backward_substitution(U, y)

        # Записываем в j-й столбец обратной матрицы
        for i in range(n):
            A_inv[i][j] = x[i]

    return A_inv


def matrix_norm(A):
    """Вычисляет норму Фробениуса матрицы"""
    n = len(A)
    s = 0.0
    for i in range(n):
        for j in range(n):
            s += A[i][j] * A[i][j]
    return s ** 0.5


