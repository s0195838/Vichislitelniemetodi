    num_points = min(len(x_h), 10)
    step = max(1, len(x_h) // num_points)
    
    for i in range(0, len(x_h), step):
        print(f"{x_h[i]:8.4f}  {y_exact(x_h[i]):14.8f}  {y_h[i]:14.8f}  "
              f"{y_h2_on_h[i]:14.8f}  {err_h[i]:12.2e}  {err_h2[i]:12.2e}")
    
    print(f"\nМаксимальная погрешность при h:   {max_err_h:.8e}")
    print(f"Максимальная погрешность при h/2: {max_err_h2:.8e}")
    if p_est:
        print(f"Порядок точности: {p_est:.4f} (теоретический: 1)")
    
    # Сохранение
    print("\nСохранение в CSV...")
    with open('results.csv', 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerow(['x', 'y_exact', 'y_h', 'y_h/2', 'err_h', 'err_h/2'])
        for i in range(len(x_h)):
            writer.writerow([x_h[i], y_exact(x_h[i]), y_h[i], y_h2_on_h[i], err_h[i], err_h2[i]])
    print("✓ Результаты сохранены в results.csv")

if __name__ == "__main__":
    main()
