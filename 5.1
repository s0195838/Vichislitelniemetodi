# ===================================================================
# СОЗДАНИЕ ПОЛЬЗОВАТЕЛЬСКОЙ ФУНКЦИИ (БЕЗ eval!)
# ===================================================================
def create_user_function(expression, var_count=2):
    """
    Создаёт функцию на основе введённого выражения БЕЗ использования eval.
    Поддерживает только простые математические операции.
    """
    # Заменяем математические функции на вызовы из math
    expr = expression
    
    # Список замен: строковое представление → вызов функции
    replacements = [
        ('sin', 'math.sin'), ('cos', 'math.cos'), ('tan', 'math.tan'),
        ('exp', 'math.exp'), ('log', 'math.log'), ('sqrt', 'math.sqrt'),
        ('abs', 'abs'), ('pow', 'pow'),
        ('pi', 'math.pi'), ('e', 'math.e'),
        ('asin', 'math.asin'), ('acos', 'math.acos'), ('atan', 'math.atan'),
        ('sinh', 'math.sinh'), ('cosh', 'math.cosh'), ('tanh', 'math.tanh')
    ]
    
    for old, new in replacements:
        expr = expr.replace(old + '(', new + '(')
    
    # Создаём функцию с помощью compile (более надёжный способ)
    try:
        if var_count == 2:
            code = compile(f"def f(x, y): return {expr}", '<string>', 'exec')
            namespace = {'math': math, 'abs': abs, 'pow': pow}
            exec(code, namespace)
            return namespace['f']
        else:
            code = compile(f"def f(x): return {expr}", '<string>', 'exec')
            namespace = {'math': math, 'abs': abs, 'pow': pow}
            exec(code, namespace)
            return namespace['f']
    except Exception as e:
        print(f"Ошибка в выражении '{expression}': {e}")
        print("Попробуйте использовать доступные примеры (1-5)")
        return None

