import math
import csv

# ===================================================================
# ЯВНЫЙ МЕТОД ЭЙЛЕРА (БЕЗ ИСПОЛЬЗОВАНИЯ eval)
# ===================================================================
def euler_explicit(f, x0, y0, h, x_end):
    """Решает ОДУ y' = f(x,y) явным методом Эйлера."""
    n_steps = int(math.ceil((x_end - x0) / h))
    x = [x0 + i * h for i in range(n_steps + 1)]
    if x[-1] > x_end + 1e-15:
        x[-1] = x_end
    y = [0.0] * (n_steps + 1)
    y[0] = y0
    for i in range(n_steps):
        h_actual = x[i+1] - x[i]
        y[i+1] = y[i] + h_actual * f(x[i], y[i])
    return x, y

# ===================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ===================================================================
def linspace(start, stop, num):
    """Создаёт равномерную сетку точек."""
    if num <= 1:
        return [start]
    step = (stop - start) / (num - 1)
    return [start + i * step for i in range(num)]

# ===================================================================
# ПРИМЕРЫ ФУНКЦИЙ (можно добавлять свои)
# ===================================================================
def example_1_f(x, y):
    """y' = -2xy"""
    return -2 * x * y

def example_1_exact(x):
    """y = e^(-x²)"""
    return math.exp(-x**2)

# -------------------------------------------------------------------
def example_2_f(x, y):
    """y' = y"""
    return y

def example_2_exact(x):
    """y = e^x"""
    return math.exp(x)

# -------------------------------------------------------------------
def example_3_f(x, y):
    """y' = cos(x)"""
    return math.cos(x)

def example_3_exact(x):
    """y = sin(x) + 1"""
    return math.sin(x) + 1

# -------------------------------------------------------------------
def example_4_f(x, y):
    """y' = y(1-y) - логистическое уравнение"""
    return y * (1 - y)

def example_4_exact(x):
    """y = 1/(1+e^(-x)) - сигмоида"""
    return 1 / (1 + math.exp(-x))

# -------------------------------------------------------------------
def example_5_f(x, y):
    """y' = x²"""
    return x**2

def example_5_exact(x):
    """y = x³/3 + 1"""
    return x**3/3 + 1

