
    import math
import csv

# ===================================================================
# РАСШИРЕННЫЙ СЛОВАРЬ МАТЕМАТИЧЕСКИХ ФУНКЦИЙ
# ===================================================================
# Добавляем функции разными способами для максимальной совместимости
_allowed_names = {}

# Способ 1: Добавляем функции из модуля math напрямую
_allowed_names.update({
    'sin': math.sin, 'cos': math.cos, 'tan': math.tan,
    'asin': math.asin, 'acos': math.acos, 'atan': math.atan,
    'atan2': math.atan2, 'sinh': math.sinh, 'cosh': math.cosh,
    'tanh': math.tanh, 'exp': math.exp, 'log': math.log,
    'log10': math.log10, 'log2': math.log2, 'sqrt': math.sqrt,
    'pow': pow, 'abs': abs,
    'pi': math.pi, 'e': math.e, 'tau': math.tau,
    'ceil': math.ceil, 'floor': math.floor, 'fabs': math.fabs,
    'factorial': math.factorial, 'gcd': math.gcd,
    'degrees': math.degrees, 'radians': math.radians,
    'erf': math.erf, 'erfc': math.erfc, 'gamma': math.gamma,
    'lgamma': math.lgamma
})

# Способ 2: Добавляем все публичные функции из math автоматически
for name in dir(math):
    if not name.startswith('_'):  # Пропускаем приватные атрибуты
        obj = getattr(math, name)
        if callable(obj) or isinstance(obj, (int, float)):  # Функции и константы
            _allowed_names[name] = obj

# Способ 3: Явно добавляем math как модуль для доступа через точку
_allowed_names['math'] = math

# ===================================================================
# ФУНКЦИЯ СОЗДАНИЯ ДВУХАРГУМЕНТНОЙ ФУНКЦИИ ИЗ СТРОКИ
# ===================================================================
def make_func_2var(expression):
    """
    Преобразует строковое выражение в функцию от двух переменных f(x,y).
    Теперь использует math. префикс для всех математических функций.
    """
    try:
        # Первый способ: пытаемся выполнить выражение как есть
        return eval(f"lambda x, y: {expression}", 
                   {"__builtins__": {}}, 
                   _allowed_names)
    except NameError as e:
        # Если не получилось, пробуем добавить math. к функциям
        modified_expr = expression
        # Заменяем основные функции на math.версии
        math_funcs = ['sin', 'cos', 'tan', 'exp', 'log', 'sqrt', 'pow', 
                     'abs', 'sinh', 'cosh', 'tanh', 'asin', 'acos', 'atan']
        for func in math_funcs:
            # Заменяем func( на math.func(
            modified_expr = modified_expr.replace(f'{func}(', f'math.{func}(')
        
        try:
            return eval(f"lambda x, y: {modified_expr}", 
                       {"__builtins__": {}}, 
                       {'math': math, 'x': 0, 'y': 0})
        except:
            raise ValueError(f"Не удалось разобрать выражение: {expression}")

# ===================================================================
# ФУНКЦИЯ СОЗДАНИЯ ОДНОАРГУМЕНТНОЙ ФУНКЦИИ ИЗ СТРОКИ
# ===================================================================
def make_func_1var(expression):
    """
    Преобразует строковое выражение в функцию от одной переменной y(x).
    """
    try:
        # Первый способ
        return eval(f"lambda x: {expression}", 
                   {"__builtins__": {}}, 
                   _allowed_names)
    except NameError as e:
        # Второй способ с math. префиксом
        modified_expr = expression
        math_funcs = ['sin', 'cos', 'tan', 'exp', 'log', 'sqrt', 'pow', 
                     'abs', 'sinh', 'cosh', 'tanh', 'asin', 'acos', 'atan']
        for func in math_funcs:
            modified_expr = modified_expr.replace(f'{func}(', f'math.{func}(')
        
        try:
            return eval(f"lambda x: {modified_expr}", 
                       {"__builtins__": {}}, 
                       {'math': math})
        except:
            raise ValueError(f"Не удалось разобрать выражение: {expression}")

# ===================================================================
# ЯВНЫЙ МЕТОД ЭЙЛЕРА (EXPLICIT EULER METHOD)
# ===================================================================
def euler_explicit(f, x0, y0, h, x_end):
    """Решает ОДУ y' = f(x,y) явным методом Эйлера."""
    n_steps = int(math.ceil((x_end - x0) / h))
    x = [x0 + i * h for i in range(n_steps + 1)]
    if x[-1] > x_end + 1e-15:
        x[-1] = x_end
    y = [0.0] * (n_steps + 1)
    y[0] = y0
    for i in range(n_steps):
        h_actual = x[i+1] - x[i]
        y[i+1] = y[i] + h_actual * f(x[i], y[i])
    return x, y

# ===================================================================
# ФУНКЦИЯ СОЗДАНИЯ РАВНОМЕРНОЙ СЕТКИ
# ===================================================================
def linspace(start, stop, num):
    """Создаёт список из num равномерно распределённых точек."""
    if num <= 1:
        return [start]
    step = (stop - start) / (num - 1)
    return [start + i * step for i in range(num)]

# ===================================================================
# ОСНОВНАЯ ПРОГРАММА
# ===================================================================
print("=" * 60)
print("Явный метод Эйлера: сравнение с точным решением")
print("=" * 60)
print("\nДоступные функции: sin, cos, tan, exp, log, sqrt, pow, pi, e и др.")
print("Можно использовать как exp(x), так и math.exp(x)")

# Ввод данных
print("\n" + "-" * 40)
f_str = input("Введите правую часть f(x,y): ").strip()
y_exact_str = input("Введите точное решение y(x): ").strip()

x0 = float(input("Начальное значение x0: "))
y0 = float(input("Начальное условие y0: "))
x_end = float(input("Конечное значение x_end: "))
h = float(input("Шаг h: "))

# Создание функций
print("\nСоздание функций...")
try:
    f = make_func_2var(f_str)
    y_exact = make_func_1var(y_exact_str)
    
    # Проверка
    test_x, test_y = 0.5, 0.5
    print(f"✓ f({test_x}, {test_y}) = {f(test_x, test_y):.6f}")
    print(f"✓ y_exact({test_x}) = {y_exact(test_x):.6f}")
    
except Exception as e:
    print(f"✗ Ошибка: {e}")
    print("\nПопробуйте альтернативный синтаксис:")
    print("  Вместо 'exp(-x**2)' напишите 'math.exp(-x**2)'")
    print("  Вместо 'sin(x)' напишите 'math.sin(x)'")
    exit(1)

# Расчёт
print("\nВыполняется расчёт...")
try:
    x_h, y_h = euler_explicit(f, x0, y0, h, x_end)
    x_h2, y_h2 = euler_explicit(f, x0, y0, h/2, x_end)
    y_h2_on_h = [y_h2[i] for i in range(0, len(y_h2), 2)]

    x_dense = linspace(x0, x_end, 200)
    y_dense = [y_exact(x) for x in x_dense]

    err_h = [abs(y_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
    err_h2 = [abs(y_h2_on_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
    
    print(f"✓ Расчёт завершён")
    
except Exception as e:
    print(f"✗ Ошибка при вычислениях: {e}")
    exit(1)

# Анализ результатов
max_err_h = max(err_h)
max_err_h2 = max(err_h2)
if max_err_h > 0 and max_err_h2 > 0:
    p_est = math.log2(max_err_h / max_err_h2)
else:
    p_est = None

# Вывод результатов
print("\n" + "=" * 70)
print("РЕЗУЛЬТАТЫ РАСЧЁТА")
print("=" * 70)

print(f"\n{'x':>8}  {'y_exact':>14}  {'y_h':>14}  {'y_h/2':>14}  {'err_h':>12}  {'err_h/2':>12}")
print("-" * 70)

num_points = min(len(x_h), 10)
step_indices = max(1, len(x_h) // num_points)

for i in range(0, len(x_h), step_indices):
    xi = x_h[i]
    ye = y_exact(xi)
    yh = y_h[i]
    yh2 = y_h2_on_h[i]
    eh = err_h[i]
    eh2 = err_h2[i]
    print(f"{xi:8.4f}  {ye:14.8f}  {yh:14.8f}  {yh2:14.8f}  {eh:12.2e}  {eh2:12.2e}")

print(f"\nМаксимальная абсолютная погрешность:")
print(f"  При шаге h = {h}:     {max_err_h:.8e}")
print(f"  При шаге h/2 = {h/2}: {max_err_h2:.8e}")

if p_est is not None:
    print(f"\nОценка фактического порядка точности: {p_est:.4f}")
    print(f"Теоретический порядок для явного метода Эйлера: 1")

# Сохранение в файлы
print("\nСохранение результатов...")

with open('comparison_h.csv', 'w', newline='', encoding='utf-8') as file:
    writer = csv.writer(file)
    writer.writerow(['x', 'y_exact', 'y_h', 'y_h/2', 'err_h', 'err_h/2'])
    for i in range(len(x_h)):
        writer.writerow([x_h[i], y_exact(x_h[i]), y_h[i], y_h2_on_h[i], err_h[i], err_h2[i]])

with open('graph_exact.csv', 'w', newline='', encoding='utf-8') as file:
    writer = csv.writer(file)
    writer.writerow(['x', 'y_exact'])
    for i in range(len(x_dense)):
        writer.writerow([x_dense[i], y_dense[i]])

with open('graph_euler.csv', 'w', newline='', encoding='utf-8') as file:
    writer = csv.writer(file)
    writer.writerow(['x_h', 'y_h', 'x_h2', 'y_h2'])
    max_len = max(len(x_h), len(x_h2))
    for i in range(max_len):
        writer.writerow([
            x_h[i] if i < len(x_h) else '',
            y_h[i] if i < len(y_h) else '',
            x_h2[i] if i < len(x_h2) else '',
            y_h2[i] if i < len(y_h2) else ''
        ])

with open('errors.csv', 'w', newline='', encoding='utf-8') as file:
    writer = csv.writer(file)
    writer.writerow(['x', 'err_h', 'err_h/2'])
    for i in range(len(x_h)):
        writer.writerow([x_h[i], err_h[i], err_h2[i]])

print("✓ Файлы сохранены успешно!")
print("\nПрограмма завершена.")
