import math
import csv
import builtins

# ===================================================================
# НАДЁЖНЫЙ СЛОВАРЬ МАТЕМАТИЧЕСКИХ ФУНКЦИЙ
# ===================================================================
# Создаём словарь ВСЕХ необходимых функций напрямую
_allowed_names = {
    # Все функции из math (явно перечисляем)
    'sin': math.sin,
    'cos': math.cos,
    'tan': math.tan,
    'asin': math.asin,
    'acos': math.acos,
    'atan': math.atan,
    'atan2': math.atan2,
    'sinh': math.sinh,
    'cosh': math.cosh,
    'tanh': math.tanh,
    'exp': math.exp,
    'log': math.log,
    'log10': math.log10,
    'log2': math.log2,
    'sqrt': math.sqrt,
    'pow': pow,
    'abs': abs,
    # Константы
    'pi': math.pi,
    'e': math.e,
    'tau': math.tau,
    # Дополнительные функции
    'ceil': math.ceil,
    'floor': math.floor,
    'fabs': math.fabs,
    'factorial': math.factorial,
    'gcd': math.gcd,
    'degrees': math.degrees,
    'radians': math.radians,
    'erf': math.erf,
    'erfc': math.erfc,
    'gamma': math.gamma,
    'lgamma': math.lgamma
}

# Добавляем все функции из math динамически (на случай если что-то пропустили)
for name in dir(math):
    if not name.startswith('_'):
        obj = getattr(math, name)
        _allowed_names[name] = obj

# ===================================================================
# ФУНКЦИЯ СОЗДАНИЯ ДВУХАРГУМЕНТНОЙ ФУНКЦИИ
# ===================================================================
def make_func_2var(expression):
    """
    Создаёт функцию f(x,y) из строки.
    Поддерживает все математические функции без префикса math.
    """
    try:
        # Компилируем код для повышения производительности
        code = compile(f"lambda x, y: {expression}", '<string>', 'eval')
        return eval(code, {"__builtins__": {}}, _allowed_names)
    except NameError as e:
        # Получаем имя функции, которая не найдена
        missing_name = str(e).split("'")[1]
        raise NameError(
            f"Неизвестная функция или переменная: '{missing_name}'\n"
            f"Доступные функции: sin, cos, tan, exp, log, sqrt, pow, abs, pi, e и др.\n"
            f"Проверьте правильность написания: {expression}"
        )
    except SyntaxError as e:
        raise SyntaxError(
            f"Ошибка синтаксиса в выражении: {expression}\n"
            f"Проверьте скобки и операторы: {e}"
        )

# ===================================================================
# ФУНКЦИЯ СОЗДАНИЯ ОДНОАРГУМЕНТНОЙ ФУНКЦИИ
# ===================================================================
def make_func_1var(expression):
    """
    Создаёт функцию y(x) из строки.
    Поддерживает все математические функции без префикса math.
    """
    try:
        code = compile(f"lambda x: {expression}", '<string>', 'eval')
        return eval(code, {"__builtins__": {}}, _allowed_names)
    except NameError as e:
        missing_name = str(e).split("'")[1]
        raise NameError(
            f"Неизвестная функция или переменная: '{missing_name}'\n"
            f"Доступные функции: sin, cos, tan, exp, log, sqrt, pow, abs, pi, e и др.\n"
            f"Проверьте правильность написания: {expression}"
        )
    except SyntaxError as e:
        raise SyntaxError(
            f"Ошибка синтаксиса в выражении: {expression}\n"
            f"Проверьте скобки и операторы: {e}"
        )

# ===================================================================
# ЯВНЫЙ МЕТОД ЭЙЛЕРА
# ===================================================================
def euler_explicit(f, x0, y0, h, x_end):
    """
    Решает ОДУ y' = f(x,y) явным методом Эйлера.
    
    Параметры:
        f: функция правой части f(x,y)
        x0, y0: начальные условия
        h: шаг интегрирования
        x_end: конечная точка
    
    Возвращает:
        x, y: списки значений
    """
    # Количество шагов (округляем вверх)
    n_steps = int(math.ceil((x_end - x0) / h))
    
    # Создаём массив x
    x = [x0 + i * h for i in range(n_steps + 1)]
    
    # Корректируем последнюю точку
    if x[-1] > x_end + 1e-15:
        x[-1] = x_end
    
    # Инициализируем массив y
    y = [0.0] * (n_steps + 1)
    y[0] = y0
    
    # Основной цикл метода Эйлера
    for i in range(n_steps):
        h_actual = x[i+1] - x[i]  # Последний шаг может быть меньше h
        y[i+1] = y[i] + h_actual * f(x[i], y[i])
    
    return x, y

# ===================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ===================================================================
def linspace(start, stop, num):
    """Создаёт равномерную сетку точек."""
    if num <= 1:
        return [start]
    step = (stop - start) / (num - 1)
    return [start + i * step for i in range(num)]

def safe_float_input(prompt):
    """Безопасный ввод числа с плавающей точкой."""
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Ошибка! Введите число (например: 0.5 или 2)")

# ===================================================================
# ТЕСТИРОВАНИЕ ФУНКЦИЙ
# ===================================================================
def test_functions():
    """Тестирует, что все функции работают корректно."""
    test_funcs = [
        ('exp(1)', math.e),
        ('sin(pi/2)', 1.0),
        ('cos(0)', 1.0),
        ('sqrt(4)', 2.0),
        ('log(e)', 1.0),
        ('abs(-5)', 5),
        ('pow(2,3)', 8)
    ]
    
    print("Тестирование математических функций...")
    for expr, expected in test_funcs:
        try:
            func = make_func_1var(expr)
            result = func(0)  # x не используется в этих тестах
            if abs(result - expected) < 1e-10:
                print(f"  ✓ {expr} = {result}")
            else:
                print(f"  ✗ {expr}: ожидалось {expected}, получено {result}")
        except Exception as e:
            print(f"  ✗ {expr}: ошибка - {e}")
    print()

# ===================================================================
# ОСНОВНАЯ ПРОГРАММА
# ===================================================================
def main():
    """Главная функция программы."""
    
    print("=" * 60)
    print("ЯВНЫЙ МЕТОД ЭЙЛЕРА ДЛЯ РЕШЕНИЯ ОДУ")
    print("=" * 60)
    print("\nПрограмма решает задачу Коши: y' = f(x,y), y(x0) = y0")
    print("и сравнивает численное решение с точным аналитическим.")
    
    # Тестируем функции перед началом работы
    test_functions()
    
    print("Доступные математические функции:")
    print("  sin, cos, tan, exp, log, sqrt, pow, abs, pi, e и др.")
    print("\nПримеры ввода:")
    print("  f(x,y): -2*x*y")
    print("  y(x):   exp(-x**2)")
    print()
    
    # Ввод данных
    print("-" * 40)
    f_str = input("Введите правую часть f(x,y): ").strip()
    y_exact_str = input("Введите точное решение y(x): ").strip()
    
    x0 = safe_float_input("Начальное значение x0: ")
    y0 = safe_float_input("Начальное условие y0: ")
    x_end = safe_float_input("Конечное значение x_end: ")
    h = safe_float_input("Шаг h: ")
    
    # Создание функций
    print("\nСоздание функций...")
    try:
        f = make_func_2var(f_str)
        y_exact = make_func_1var(y_exact_str)
        
        # Проверка созданных функций
        test_x, test_y = 0.5, 0.5
        f_val = f(test_x, test_y)
        y_val = y_exact(test_x)
        
        print(f"✓ f({test_x}, {test_y}) = {f_val:.6f}")
        print(f"✓ y_exact({test_x}) = {y_val:.6f}")
        
    except Exception as e:
        print(f"✗ Ошибка: {e}")
        print("\nСоветы по исправлению:")
        print("• Используйте ** для возведения в степень: x**2")
        print("• Функции пишите со скобками: sin(x), exp(-x)")
        print("• Умножение всегда с *: 2*x, а не 2x")
        return
    
    # Расчёт
    print("\nВыполняется расчёт...")
    try:
        # Решения с разными шагами
        x_h, y_h = euler_explicit(f, x0, y0, h, x_end)
        x_h2, y_h2 = euler_explicit(f, x0, y0, h/2, x_end)
        
        # Значения h/2 в узлах сетки h
        y_h2_on_h = [y_h2[i] for i in range(0, len(y_h2), 2)]
        
        # Точное решение на плотной сетке
        x_dense = linspace(x0, x_end, 200)
        y_dense = [y_exact(x) for x in x_dense]
        
        # Погрешности
        err_h = [abs(y_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
        err_h2 = [abs(y_h2_on_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
        
        print(f"✓ Расчёт завершён успешно")
        print(f"  Точек с шагом h: {len(x_h)}")
        print(f"  Точек с шагом h/2: {len(x_h2)}")
        
    except Exception as e:
        print(f"✗ Ошибка при вычислениях: {e}")
        print("Возможно, точное решение содержит ошибку.")
        return
    
    # Анализ результатов
    max_err_h = max(err_h)
    max_err_h2 = max(err_h2)
    
    if max_err_h > 0 and max_err_h2 > 0:
        p_est = math.log2(max_err_h / max_err_h2)
    else:
        p_est = None
    
    # Вывод результатов
    print("\n" + "=" * 70)
    print("РЕЗУЛЬТАТЫ РАСЧЁТА")
    print("=" * 70)
    
    print(f"\n{'x':>8}  {'y_exact':>14}  {'y_h':>14}  {'y_h/2':>14}  {'err_h':>12}  {'err_h/2':>12}")
    print("-" * 70)
    
    # Показываем 10 равномерно распределённых точек
    num_points = min(len(x_h), 10)
    step = max(1, len(x_h) // num_points)
    
    for i in range(0, len(x_h), step):
        print(f"{x_h[i]:8.4f}  {y_exact(x_h[i]):14.8f}  {y_h[i]:14.8f}  "
              f"{y_h2_on_h[i]:14.8f}  {err_h[i]:12.2e}  {err_h2[i]:12.2e}")
    
    print(f"\nМаксимальная абсолютная погрешность:")
    print(f"  При шаге h = {h}:     {max_err_h:.8e}")
    print(f"  При шаге h/2 = {h/2}: {max_err_h2:.8e}")
    
    if p_est is not None:
        print(f"\nОценка порядка точности: {p_est:.4f}")
        print(f"Теоретический порядок метода Эйлера: 1")
    
    # Сохранение результатов
    print("\n" + "-" * 40)
    print("Сохранение результатов в CSV-файлы...")
    
    try:
        # Файл 1: Таблица сравнения
        with open('comparison.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(['x', 'y_exact', 'y_h', 'y_h/2', 'err_h', 'err_h/2'])
            for i in range(len(x_h)):
                writer.writerow([
                    x_h[i], y_exact(x_h[i]), y_h[i], 
                    y_h2_on_h[i], err_h[i], err_h2[i]
                ])
        
        # Файл 2: Точное решение
        with open('exact_solution.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(['x', 'y_exact'])
            for i in range(len(x_dense)):
                writer.writerow([x_dense[i], y_dense[i]])
        
        # Файл 3: Численные решения
        with open('euler_solutions.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(['x_h', 'y_h', 'x_h2', 'y_h2'])
            max_len = max(len(x_h), len(x_h2))
            for i in range(max_len):
                writer.writerow([
                    x_h[i] if i < len(x_h) else '',
                    y_h[i] if i < len(y_h) else '',
                    x_h2[i] if i < len(x_h2) else '',
                    y_h2[i] if i < len(y_h2) else ''
                ])
        
        # Файл 4: Погрешности
        with open('errors.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(['x', 'err_h', 'err_h/2'])
            for i in range(len(x_h)):
                writer.writerow([x_h[i], err_h[i], err_h2[i]])
        
        print("✓ Файлы успешно сохранены:")
        print("  • comparison.csv - полная таблица сравнения")
        print("  • exact_solution.csv - точное решение")
        print("  • euler_solutions.csv - численные решения")
        print("  • errors.csv - погрешности")
        
    except Exception as e:
        print(f"✗ Ошибка при сохранении файлов: {e}")
    
    print("\n" + "=" * 60)
    print("Программа завершена успешно!")
    print("=" * 60)

# ===================================================================
# ЗАПУСК ПРОГРАММЫ
# ===================================================================
if __name__ == "__main__":
    main()
