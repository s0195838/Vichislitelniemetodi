        print("Пример: e^(-x²) → нужно ввести: math.exp(-x**2)")
        
        f_str = input("\nf(x,y) = ").strip()
        y_str = input("y(x) = ").strip()
        
        f = create_user_function(f_str, var_count=2)
        y_exact = create_user_function(y_str, var_count=1)
        
        if f is None or y_exact is None:
            print("Не удалось создать функции. Используйте примеры (режим 1).")
            return
        
        try:
            x0 = float(input("x0 = "))
            y0 = float(input("y0 = "))
            x_end = float(input("x_end = "))
            h = float(input("h = "))
        except ValueError:
            print("Ошибка ввода чисел!")
            return
    else:
        print("Неверный выбор!")
        return
    
    # Проверка функций
    print("\nПроверка функций...")
    try:
        test_x, test_y = 0.5, 0.5
        print(f"  f({test_x}, {test_y}) = {f(test_x, test_y):.6f}")
        print(f"  y({test_x}) = {y_exact(test_x):.6f}")
    except Exception as e:
        print(f"Ошибка при проверке функций: {e}")
        return
    
    # Расчёт
    print("\nВыполняется расчёт...")
    try:
        x_h, y_h = euler_explicit(f, x0, y0, h, x_end)
        x_h2, y_h2 = euler_explicit(f, x0, y0, h/2, x_end)
        y_h2_on_h = [y_h2[i] for i in range(0, len(y_h2), 2)]
        
        x_dense = linspace(x0, x_end, 200)
        y_dense = [y_exact(x) for x in x_dense]
        
        err_h = [abs(y_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
        err_h2 = [abs(y_h2_on_h[i] - y_exact(x_h[i])) for i in range(len(x_h))]
        
        print("✓ Расчёт завершён")
    except Exception as e:
        print(f"Ошибка при расчёте: {e}")
        return
    
    # Результаты
    max_err_h = max(err_h)
    max_err_h2 = max(err_h2)
    p_est = math.log2(max_err_h / max_err_h2) if max_err_h > 0 and max_err_h2 > 0 else None
    
    print("\n" + "=" * 70)
    print("РЕЗУЛЬТАТЫ")
    print("=" * 70)
    print(f"\n{'x':>8}  {'y_exact':>14}  {'y_h':>14}  {'y_h/2':>14}  {'err_h':>12}  {'err_h/2':>12}")
