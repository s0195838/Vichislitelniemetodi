        y_exact = ex['exact']
        x0 = ex['x0']
        y0 = ex['y0']
        x_end = ex['x_end']
        h = ex['h']
        
        print(f"\nВыбран пример: {ex['name']}")
        
    elif choice == '2':
        # Пользовательский ввод
        print("\n⚠️  Экспериментальный режим!")
        print("Поддерживаются функции: sin, cos, tan, exp, log, sqrt, abs, pow")
