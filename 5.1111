// ======================================================================
//  УНИВЕРСАЛЬНЫЙ ЧИСЛЕННЫЙ РЕШАТЕЛЬ ЗАДАЧИ КОШИ ДЛЯ ОДУ 1-ГО ПОРЯДКА
//  Метод: НЕЯВНЫЙ ЭЙЛЕРА (Implicit Euler)
// ======================================================================
//  Решает:  y' = f(x, y)
//  При:     y(x0) = y0
//  На:      отрезке [x0, xn] с постоянным шагом h
//
//  ВОЗМОЖНОСТИ:
//  - Выбор из каталога уравнений (4 предустановленных).
//  - Решение с тремя шагами (h, h/2, h/4) для правила Рунге.
//  - Сравнение с точным аналитическим решением (если задано).
//  - Экспериментальное определение порядка точности p.
//  - Экспорт в CSV для построения графиков.
// ======================================================================

// ======================================================================
//  БЛОК 1: ПОДКЛЮЧАЕМЫЕ БИБЛИОТЕКИ — ИНСТРУМЕНТЫ ДЛЯ РАБОТЫ
// ======================================================================

#include <iostream>   
// iostream = input/output stream (потоки ввода/вывода)
// Дает: cin (console input) — чтение с клавиатуры
//       cout (console output) — печать на экран
// Без этого программа "слепая и немая".

#include <vector>     
// vector<T> — динамический массив. В отличие от обычного массива,
// сам знает свой размер, умеет расширяться, передается по значению.
// Здесь хранит все значения y на сетке: y[0], y[1], ..., y[N].

#include <cmath>      
// cmath = C Math library (математическая библиотека языка C).
// Дает: exp(x) — e^x
//       log(x) — натуральный логарифм ln(x)
//       sin(x), cos(x)
//       fabs(x) — модуль для double (floating point absolute value)

#include <fstream>    
// fstream = file stream (файловые потоки).
// Дает: ofstream — output file stream (запись в файл).
// Нужен для сохранения данных в graph.csv.

#include <iomanip>    
// iomanip = input/output manipulators (манипуляторы ввода/вывода).
// Дает: fixed — вывод чисел с фиксированной точкой (а не научный 1.2e3)
//       setprecision(n) — сколько цифр после запятой
// Без этого 1.2 может вывестись как 1.2000000000000002.

#include <string>     
// string — строка как объект (удобнее, чем char[]).
// Здесь: хранение названий уравнений и имен файлов.

using namespace std;
// namespace std — "стандартное пространство имен".
// Все объекты из подключенных библиотек живут внутри std::
// Без этой строки пришлось бы писать std::cout, std::vector, std::exp.
// С ней пишем просто cout, vector, exp. Экономит код, но в больших
// проектах так делать не принято (могут быть конфликты имен).

// ======================================================================
//  БЛОК 2: ТЕОРИЯ — ТИП ДАННЫХ ДЛЯ ФУНКЦИИ ПРАВОЙ ЧАСТИ
// ======================================================================

// typedef — создание синонима типа (type definition).
// 
// double (*Func)(double, double) читается из центра наружу:
//   (*Func)        — Func это УКАЗАТЕЛЬ
//   (*Func)(double, double) — на ФУНКЦИЮ, принимающую два double
//   double (*Func)(double, double) — и возвращающую double
//
// Зачем: теперь можно написать Func f = f1;
//        и передавать f в другие функции.
//        Это делает implicitEuler НЕЗАВИСИМЫМ от конкретного уравнения.
typedef double (*Func)(double, double);

// ======================================================================
//  БЛОК 3: КАТАЛОГ УРАВНЕНИЙ (можно дополнять)
// ======================================================================
// Каждое уравнение — это ПАРА функций:
//   f(x, y) — правая часть ОДУ
//   exact(x) — точное решение (аналитическое)
// Если точного нет — передаем nullptr.

// --- Уравнение 1: y' = x + y ---
// Словами: скорость роста равна сумме времени и текущего значения.
// Точное: y = 2*e^x - x - 1  (при y(0)=1)

double f1(double x, double y)
{
    return x + y;   // просто сумма: чем больше x и y, тем быстрее рост
}

double exact1(double x)
{
    return 2.0 * exp(x) - x - 1.0;
    // exp(x) = e^x. Двойка перед exp — из начального условия.
}

// --- Уравнение 2: y' = y - x^2 + 1 ---
// Словами: есть естественный рост (y), его тормозит квадрат времени (-x^2)
//          и подпитывает постоянный приток (+1).
// Точное: y = (x+1)^2 - 0.5*e^x  (при y(0)=0.5)

double f2(double x, double y)
{
    return y - x * x + 1.0;
    // x*x — это x^2. Умножение быстрее, чем pow(x,2).
}

double exact2(double x)
{
    return (x + 1.0) * (x + 1.0) - 0.5 * exp(x);
    // (x+1)*(x+1) — это (x+1)^2. Опять же, умножение быстрее pow.
}

// --- Уравнение 3: y' = -2*x*y  (гауссов импульс) ---
// Словами: скорость пропорциональна y и x, но отрицательна.
//          Чем дальше от нуля — тем быстрее убывает.
// Точное: y = e^(-x^2)  (колоколообразная кривая)

double f3(double x, double y)
{
    return -2.0 * x * y;
}

double exact3(double x)
{
    return exp(-x * x);
    // При x=0: exp(0) = 1. При x→∞: exp(-∞) → 0.
}

// --- Уравнение 4: y' = sin(x) * y ---
// Словами: скорость — это y, умноженное на sin(x).
//          Когда sin > 0 — рост, когда sin < 0 — убывание.
// Точное: y = e^(1 - cos(x))  (при y(0)=1)

double f4(double x, double y)
{
    return sin(x) * y;
}

double exact4(double x)
{
    return exp(1.0 - cos(x));
    // При x=0: cos(0)=1 → exp(1-1) = exp(0) = 1.
    // Функция колеблется, но всегда положительна.
}

// ======================================================================
//  БЛОК 4: СЕРДЦЕ ПРОГРАММЫ — НЕЯВНЫЙ МЕТОД ЭЙЛЕРА
// ======================================================================

vector<double> implicitEuler(
    Func f,            // УКАЗАТЕЛЬ на функцию правой части f(x,y)
    double x0,         // начальное значение x (левая граница)
    double y0,         // начальное условие y(x0) = y0
    double xn,         // конечное значение x (правая граница)
    double h)          // шаг сетки (расстояние между соседними точками)
{
    // ---------------------------------------------------------------
    // Шаг 1: ВЫЧИСЛЯЕМ КОЛИЧЕСТВО ШАГОВ N
    // ---------------------------------------------------------------
    // Формула: N = (xn - x0) / h
    // Но! Из-за двоичного представления дробей (0.1 = 0.000110011...)
    // результат деления может быть, например, 19.9999999999 вместо 20.
    // При приведении к int дробная часть просто ОТБРАСЫВАЕТСЯ:
    // (int)19.9999 = 19. Это ошибка на 1 шаг.
    // Чтобы этого избежать, добавляем 0.5 перед отбрасыванием:
    // (int)(19.9999 + 0.5) = (int)(20.4999) = 20. Исправлено.
    int N = (int)((xn - x0) / h + 0.5);

    // ---------------------------------------------------------------
    // Шаг 2: СОЗДАЕМ ВЕКТОР ДЛЯ ХРАНЕНИЯ РЕШЕНИЯ
    // ---------------------------------------------------------------
    // vector<double> y(N+1) — создает массив из N+1 элемента,
    // заполненный нулями (конструктор по умолчанию для double дает 0.0).
    // Индексы: 0, 1, 2, ..., N. Всего N+1 точка.
    // y[0]   — значение в x0
    // y[1]   — значение в x0+h
    // y[i]   — значение в x0 + i*h
    // y[N]   — значение в xn
    vector<double> y(N + 1);

    // Начальное условие: y(x0) = y0
    y[0] = y0;

    // ---------------------------------------------------------------
    // Шаг 3: ОСНОВНОЙ ЦИКЛ — ДВИЖЕМСЯ ПО СЕТКЕ
    // ---------------------------------------------------------------
    // i — номер текущего шага. Начинаем с 0 (точка x0 уже известна).
    // На каждом шаге вычисляем y[i+1] по известному y[i].
    for (int i = 0; i < N; i++)
    {
        // x_{i+1} — координата СЛЕДУЮЩЕЙ точки
        double xNext = x0 + (i + 1) * h;

        // ---------------------------------------------------------
        // Шаг 3a: НАЧАЛЬНОЕ ПРИБЛИЖЕНИЕ ДЛЯ y_{i+1}
        // ---------------------------------------------------------
        // В неявном методе Эйлера уравнение на y_{i+1}:
        //   y_{i+1} = y_i + h * f(x_{i+1}, y_{i+1})
        // 
        // Это УРАВНЕНИЕ (y_{i+1} слева и справа), его нужно решать.
        // Метод простой итерации требует начального приближения z_0.
        // Берем z_0 = y_i — самое логичное: функция не прыгает,
        // значит y_{i+1} примерно равно y_i.
        double yNew = y[i];

        // ---------------------------------------------------------
        // Шаг 3b: МЕТОД ПРОСТОЙ ИТЕРАЦИИ
        // ---------------------------------------------------------
        // Переписываем уравнение в виде y = g(y):
        //   y = y_i + h * f(xNext, y)   =>   y = g(y)
        // 
        // Метод: z_{k+1} = g(z_k). Начинаем с z_0 = y[i].
        // Повторяем, пока |z_{k+1} - z_k| не станет < 1e-12.
        //
        // УСЛОВИЕ СХОДИМОСТИ: |g'(y)| < 1.
        // g(y) = y_i + h * f(xNext, y)
        // g'(y) = h * ∂f/∂y.
        // Для сходимости нужно |h * ∂f/∂y| < 1, то есть h < 1/|∂f/∂y|.
        // При малых h это всегда выполняется. Наши h и функции выбраны
        // так, что сходимость есть.
        //
        // 100 итераций — это "защита от дурака". Для хороших h
        // сходимость наступает за 5-10 итераций.
        for (int k = 0; k < 100; k++)
        {
            double yOld = yNew;   // запоминаем z_k

            // Вычисляем z_{k+1} = g(z_k):
            // y_{i+1} = y_i + h * f(x_{i+1}, z_k)
            // Вызов f(xNext, yOld) — вот где проявляется универсальность!
            // Для f1 это x+y, для f3 это -2xy и т.д.
            yNew = y[i] + h * f(xNext, yOld);

            // Проверка сходимости:
            // fabs(a) = |a| (модуль для double).
            // 1e-12 = 0.000000000001 — очень маленькое число.
            // Меньше — смысла нет: double хранит ~15 значащих цифр,
            // и ошибки округления уже могут быть больше.
            if (fabs(yNew - yOld) < 1e-12)
                break;   // выходим из цикла k, решение найдено
        }

        // Сохраняем найденное y_{i+1}
        y[i + 1] = yNew;
    }

    // Возвращаем готовый вектор значений
    return y;
}

// ======================================================================
//  БЛОК 5: ФУНКЦИЯ АНАЛИЗА — ЗАПУСКАЕТ МЕТОД И ОЦЕНИВАЕТ КАЧЕСТВО
// ======================================================================

void analyzeMethod(
    Func f,                          // правая часть ОДУ
    double (*exact)(double),         // точное решение (может быть nullptr!)
    double x0, double y0,            // начальное условие
    double xn, double h,             // отрезок и шаг
    const string& eqName)            // название уравнения для вывода
    // const string& — ссылка на константную строку.
    // & означает, что строка не копируется (экономия памяти).
    // const означает, что мы не можем её изменить внутри функции.
{
    cout << "\n====================================================\n";
    cout << "УРАВНЕНИЕ: " << eqName << "\n";
    cout << "====================================================\n";

    // ---------------------------------------------------------------
    // ЗАПУСК МЕТОДА С ТРЕМЯ ШАГАМИ
    // ---------------------------------------------------------------
    // Три сетки для правила Рунге:
    //   Yh  — крупная, шаг h.    Количество точек: N+1.
    //   Yh2 — средняя, шаг h/2.  Количество точек: 2N+1.
    //   Yh4 — мелкая,  шаг h/4.  Количество точек: 4N+1.
    vector<double> Yh = implicitEuler(f, x0, y0, xn, h);
    vector<double> Yh2 = implicitEuler(f, x0, y0, xn, h / 2.0);
    vector<double> Yh4 = implicitEuler(f, x0, y0, xn, h / 4.0);

    // Количество шагов на крупной сетке
    int N = (int)((xn - x0) / h + 0.5);

    // ---------------------------------------------------------------
    // СРАВНЕНИЕ С ТОЧНЫМ РЕШЕНИЕМ (если exact != nullptr)
    // ---------------------------------------------------------------
    if (exact != nullptr)   // != nullptr означает "указатель не пустой"
    {
        double maxErrH = 0.0;   // максимальная ошибка для шага h
        double maxErrH2 = 0.0;   // максимальная ошибка для шага h/2

        // Форматирование вывода:
        // fixed — числа как 1.23 (а не 1.23e+00)
        // setprecision(8) — 8 знаков после запятой
        cout << fixed << setprecision(8);
        cout << "\n   x          Точное       Числен.(h)      Ошибка\n";
        cout << "------------------------------------------------------------\n";

        // Цикл по точкам крупной сетки
        for (int i = 0; i <= N; i++)
        {
            double x = x0 + i * h;          // координата x
            double ex = exact(x);           // точное y(x)
            double err = fabs(Yh[i] - ex);  // |численное - точное|

            // max(a,b) — шаблонная функция, возвращает большее из двух.
            // Так мы постепенно находим максимум ошибки.
            maxErrH = max(maxErrH, err);

            // "\t" — символ табуляции, делает колонки ровными.
            cout << x << "\t"
                << ex << "\t"
                << Yh[i] << "\t"
                << err << "\n";
        }

        // Ошибка для шага h/2: нужно больше точек (2N+1)
        for (int i = 0; i <= 2 * N; i++)
        {
            double x = x0 + i * (h / 2.0);
            double err = fabs(Yh2[i] - exact(x));
            maxErrH2 = max(maxErrH2, err);
        }

        // Вывод сводки
        cout << "\n--- МАКСИМАЛЬНАЯ ОШИБКА ---\n";
        cout << "Шаг h:   " << maxErrH << "\n";
        cout << "Шаг h/2: " << maxErrH2 << "\n";

        // Отношение ошибок: если метод порядка p, то
        // Error(h) / Error(h/2) ≈ 2^p.
        // Для p=1 должно быть ≈ 2.
        if (maxErrH2 > 0.0)
            cout << "Отношение: Error(h)/Error(h/2) = "
            << maxErrH / maxErrH2
            << "  (ожидаем ~2 для метода 1-го порядка)\n";
    }
    else
    {
        cout << "(Точное решение не задано — сравнение невозможно.)\n";
    }

    // ---------------------------------------------------------------
    // ПРАВИЛО РУНГЕ ДЛЯ ОЦЕНКИ ПОРЯДКА ТОЧНОСТИ p
    // ---------------------------------------------------------------
    // ТЕОРИЯ:
    // Ошибка метода: E(h) = y_точн - y_h ≈ C * h^p.
    // Мы не знаем C, но она СОКРАЩАЕТСЯ при делении!
    //
    // Разница решений на соседних сетках:
    // D1 = max|y_h - y_{h/2}| ≈ |C| * h^p * |1 - 1/2^p|
    // D2 = max|y_{h/2} - y_{h/4}| ≈ |C| * (h/2)^p * |1 - 1/2^p|
    //
    // Делим D1 на D2:
    // D1/D2 = h^p / (h/2)^p = 2^p.
    //
    // Отсюда: p = log_2(D1/D2) = ln(D1/D2) / ln(2).

    double diff1 = 0.0;   // D1 = max|Yh - Yh2|
    double diff2 = 0.0;   // D2 = max|Yh2 - Yh4|

    // Сравниваем ТОЛЬКО в общих точках (узлах крупной сетки).
    for (int i = 0; i <= N; i++)
    {
        // Индексация:
        // Yh[i]     — крупная сетка, индекс i
        // Yh2[2*i]  — средняя сетка, индекс 2*i (та же точка x!)
        // Yh4[4*i]  — мелкая сетка, индекс 4*i (та же точка x!)
        //
        // Почему 2*i и 4*i?
        // Крупная сетка: точки x0, x0+h, x0+2h, ...
        // Средняя сетка: точки x0, x0+h/2, x0+h, ...
        // Точка x0+i*h крупной сетки — это точка номер 2*i средней.
        // Аналогично для мелкой: номер 4*i.

        diff1 = max(diff1, fabs(Yh[i] - Yh2[2 * i]));
        diff2 = max(diff2, fabs(Yh2[2 * i] - Yh4[4 * i]));
    }

    // Вычисление p:
    // log(x) в C++ — это натуральный логарифм (ln).
    // log(a) / log(b) = log_b(a) — логарифм a по основанию b.
    double p = log(diff1 / diff2) / log(2.0);

    cout << "\n--- ПРАВИЛО РУНГЕ (оценка порядка точности) ---\n";
    cout << "D1 = max|Yh - Yh2|   = " << diff1 << "\n";
    cout << "D2 = max|Yh2 - Yh4|  = " << diff2 << "\n";
    cout << "Порядок точности p  = " << p
        << "  (теоретически p ≈ 1)\n";

    // ---------------------------------------------------------------
    // ЭКСПОРТ В CSV
    // ---------------------------------------------------------------
    // CSV = Comma-Separated Values (значения, разделенные запятыми).
    // У нас разделитель — точка с запятой (;), это стандарт для
    // русского Excel (где запятая — десятичный разделитель).

    // Формируем имя файла из названия уравнения
    string filename = "graph_" + eqName + ".csv";
    // Заменяем "нехорошие" символы в имени файла на '_'
    for (char& c : filename)
        if (c == ' ' || c == '\'' || c == '^' || c == '*' || c == '=')
            c = '_';

    // ofstream — объект для записи в файл.
    // При создании файл открывается (или перезаписывается).
    ofstream csv(filename);

    // Заголовок CSV: имена колонок
    csv << "x;exact;euler_h;euler_h2\n";

    // Данные: только в узлах крупной сетки
    for (int i = 0; i <= N; i++)
    {
        double x = x0 + i * h;

        csv << fixed << setprecision(10)
            << x << ";"
            // (exact ? exact(x) : 0.0) — тернарный оператор.
            // Если exact не nullptr — вызываем exact(x),
            // иначе — пишем 0.0 (заглушка).
            << (exact ? exact(x) : 0.0) << ";"
            << Yh[i] << ";"           // решение с крупным шагом
            << Yh2[2 * i] << "\n";    // решение со средним шагом в той же x
    }

    csv.close();   // Закрываем файл (иначе данные могут потеряться)

    cout << "Результаты сохранены в '" << filename << "'\n";
}

// ======================================================================
//  БЛОК 6: ГЛАВНАЯ ФУНКЦИЯ — ТОЧКА ВХОДА В ПРОГРАММУ
// ======================================================================
// main() — первое, что выполняется при запуске.
// return 0 — программа завершилась успешно.
// return 1 — программа завершилась с ошибкой.

int main()
{
    // Приветствие
    cout << "====================================================\n";
    cout << "  УНИВЕРСАЛЬНЫЙ РЕШАТЕЛЬ ОДУ\n";
    cout << "  Неявный метод Эйлера\n";
    cout << "====================================================\n\n";

    // Вывод меню
    cout << "Доступные уравнения:\n\n";
    cout << "  1. y' = x + y\n";
    cout << "     Точное: y = 2*e^x - x - 1\n\n";
    cout << "  2. y' = y - x^2 + 1\n";
    cout << "     Точное: y = (x+1)^2 - 0.5*e^x\n\n";
    cout << "  3. y' = -2*x*y  (гауссово затухание)\n";
    cout << "     Точное: y = e^(-x^2)\n\n";
    cout << "  4. y' = sin(x) * y\n";
    cout << "     Точное: y = e^(1 - cos(x))\n\n";

    int choice;
    cout << "Выберите уравнение (1-4): ";
    cin >> choice;   // Читаем число с клавиатуры

    // Указатели на выбранные функции.
    // nullptr — специальное значение "пустой указатель", "ничего".
    Func f = nullptr;
    double (*exact)(double) = nullptr;
    string eqName;

    // switch — выбор по значению переменной choice.
    switch (choice)
    {
    case 1:
        f = f1;        // присваиваем указателю адрес функции f1
        exact = exact1;
        eqName = "y' = x + y";
        break;         // break обязателен, иначе "провалимся" в case 2

    case 2:
        f = f2;
        exact = exact2;
        eqName = "y' = y - x^2 + 1";
        break;

    case 3:
        f = f3;
        exact = exact3;
        eqName = "y' = -2xy";
        break;

    case 4:
        f = f4;
        exact = exact4;
        eqName = "y' = sin(x) * y";
        break;

    default:   // если choice не 1, 2, 3, 4
        cout << "Неверный выбор. Завершение программы.\n";
        return 1;   // код ошибки
    }

    // Ввод параметров
    double x0, y0, xn, h;

    cout << "\nВведите параметры задачи:\n";
    cout << "x0 = ";
    cin >> x0;
    cout << "y0 = ";
    cin >> y0;
    cout << "xn = ";
    cin >> xn;
    cout << "h  = ";
    cin >> h;

    // Запуск анализа
    analyzeMethod(f, exact, x0, y0, xn, h, eqName);

    // Инструкция по расширению
    cout << "\n====================================================\n";
    cout << "КАК ДОБАВИТЬ СВОЕ УРАВНЕНИЕ:\n";
    cout << "1. Добавьте функции f5 и exact5 в начало файла.\n";
    cout << "2. Добавьте case 5 в switch.\n";
    cout << "3. Если точного решения нет — передайте nullptr.\n";
    cout << "   Тогда программа посчитает только порядок по Рунге.\n";
    cout << "====================================================\n";

    return 0;   // успешное завершение
}
